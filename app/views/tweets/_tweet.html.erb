<div id="<%= dom_id tweet %>">
  <%= link_to account_path(tweet.user), class: "flex" do %>
    <p class="font-bold">
      <%= tweet.user.user_name %> 
    </p>
    <%= "@#{tweet.user.account}" %>
  <% end %>
  <%= link_to account_tweet_path(account: tweet.user.account, id: tweet.id) do %>
    <p><%= tweet.tweet_text %></p>
  <% end %>
</div>