<%# locals: (tweet:) -%>

<%= form_with(model: tweet) do |form| %>

  <%= form.text_field :tweet_text,
      maxlength: 140,
      placeholder: "いまどうしてる？",
      class: "w-full max-w-xl rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
  <%= form.hidden_field :user_id %>

  <% if form.object.errors.any? %>
    <ul class="mt-2 list-inside list-disc text-sm text-red-600">
      <% form.object.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="mt-3">
    <%= form.submit "投稿する",
        class: "inline-flex items-center rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-300" %>
  </div>
<% end %>